                                                  Style="{DynamicResource OptionCheckBox}" />
                                    </WrapPanel>
                                    <StackPanel Style="{DynamicResource CardRowLast}">
                                        <TextBlock Text="{DynamicResource Tab1.Page2.LockPresent}"
                                                   Style="{DynamicResource FieldLabel}" Width="120" />
