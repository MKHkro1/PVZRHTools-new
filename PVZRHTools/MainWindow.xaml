                            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                                <TextBlock Text="搜索关键词" Style="{DynamicResource SectionHeaderText}" />
                                <TextBox x:Name="SearchBox" 
                                         Height="35" 
                                         FontSize="14"
                                         TextChanged="SearchBox_TextChanged"
                                         VerticalContentAlignment="Center"
                                         Padding="10,0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <!-- ★ 内联 Style 会【整体替换】SimpleTheme 的隐式 TextBox 样式，
                                                 不写 Background/Foreground 就回落到 WPF 默认（纯白底）⇒
                                                 深色模式下这个搜索框仍是白底（用户实测）。
                                                 这里显式补上主题令牌，与隐式样式保持一致。 -->
                                            <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                                            <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
                                            <Setter Property="SelectionBrush" Value="{DynamicResource LabelForegroundBrush}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                            
                            <!-- 搜索结果 -->
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="搜索结果" Style="{DynamicResource SectionHeaderText}" />
                                <Border Style="{DynamicResource SettingsCard}">
                                <StackPanel Orientation="Vertical">
                                <!-- 植物结果 -->
                                <Expander x:Name="PlantsExpander" Header="{DynamicResource Tab11.Results.Plants}" Margin="0,0,0,7">
                                    <ListBox x:Name="PlantsResultsListBox" 
                                             MaxHeight="200" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                
                                <!-- 僵尸结果 -->
                                <Expander x:Name="ZombiesExpander" Header="{DynamicResource Tab11.Results.Zombies}" Margin="0,0,0,7">
                                    <ListBox x:Name="ZombiesResultsListBox" 
                                             MaxHeight="200" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                
                                <!-- 词条结果 -->
                                <Expander x:Name="BuffsExpander" Header="{DynamicResource Tab11.Results.Buffs}" Margin="0,0,0,7">
                                    <ListBox x:Name="BuffsResultsListBox" 
                                             MaxHeight="200" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                
                                <!-- 子弹结果 -->
                                <Expander x:Name="BulletsExpander" Header="{DynamicResource Tab11.Results.Bullets}" Margin="0,0,0,7">
                                    <ListBox x:Name="BulletsResultsListBox" 
                                             MaxHeight="200" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                
                                <!-- 物品结果 -->
                                <Expander x:Name="ItemsExpander" Header="{DynamicResource Tab11.Results.Items}" Margin="0,0,0,7">
                                    <ListBox x:Name="ItemsResultsListBox" 
                                             MaxHeight="200" 
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </Expander>
                                </StackPanel>
                                </Border>
                            </StackPanel>
                            
                            <!-- 特效和音效播放 -->
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{DynamicResource Tab11.EffectPlay.Header}" Style="{DynamicResource SectionHeaderText}" />
                                
                                <!-- 特效播放 -->
                                <Border Style="{DynamicResource NoticeBanner}" Margin="0,0,0,7">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{DynamicResource Tab11.EffectPlay.ParticleID}" Style="{DynamicResource FieldLabel}" Width="120" />
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBox x:Name="ParticleIdTextBox"
                                                     Width="150"
                                                     Height="30"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding ParticleId, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,10,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <!-- ★ 内联 Style 会替换 SimpleTheme 的隐式 TextBox 样式，
                                                             必须显式补主题令牌，否则深色下回落成白底。 -->
                                                        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                                                        <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
                                                        <Setter Property="SelectionBrush" Value="{DynamicResource LabelForegroundBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="5,0" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="{DynamicResource Tab11.EffectPlay.PlayParticle}"
                                                    Width="100"
                                                    Height="30"
                                                    Click="PlayParticleButton_Click"
                                                    Foreground="{DynamicResource TextForegroundBrush}"
                                                    VerticalContentAlignment="Center"
                                                    HorizontalContentAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                
                                <!-- 音效播放 -->
                                <Border Style="{DynamicResource NoticeBanner}">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="{DynamicResource Tab11.EffectPlay.SoundID}" Style="{DynamicResource FieldLabel}" Width="120" />
                                        <WrapPanel Orientation="Horizontal">
                                            <TextBox x:Name="SoundIdTextBox"
                                                     Width="150"
                                                     Height="30"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding SoundId, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,10,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <!-- ★ 内联 Style 会替换 SimpleTheme 的隐式 TextBox 样式，
                                                             必须显式补主题令牌，否则深色下回落成白底。 -->
                                                        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                                                        <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundBrush}" />
                                                        <Setter Property="SelectionBrush" Value="{DynamicResource LabelForegroundBrush}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="TextBox">
                                                                    <Border Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                                            CornerRadius="4">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="5,0" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <Button Content="{DynamicResource Tab11.EffectPlay.PlaySound}"
                                                    Width="100"
                                                    Height="30"
                                                    Click="PlaySoundButton_Click"
                                                    Foreground="{DynamicResource TextForegroundBrush}"
                                                    VerticalContentAlignment="Center"
                                                    HorizontalContentAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
            
            <!-- Tab12: 出怪修改 -->
            <TabItem Header="出怪修改" Tag="&#xE76D;">
                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                        <!-- ★ 2026-09-25 统一页骨架（本页标题为硬编码文案，沿用原文案） -->
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                                <TextBlock Text="出怪修改" Style="{DynamicResource PageTitleText}" Margin="2,0,0,10" />
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <!-- 当前波数显示 -->
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="当前波数:" Style="{DynamicResource FieldLabel}"
                                                       FontWeight="SemiBold" Width="100" />
                                            <Label x:Name="CurrentWaveLabel" Content="未获取" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SuccessForegroundBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <!-- 刷新按钮 -->
                                        <StackPanel Style="{DynamicResource CardRowLast}">
                                            <Button x:Name="RefreshZombieListButton"
                                                    Content="刷新获取出怪列表"
                                                    Click="RefreshZombieListButton_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 出怪列表容器 -->
                                <StackPanel x:Name="ZombieListContainer" Orientation="Vertical">
                                    <!-- 动态生成的波次列表将显示在这里 -->
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
            
            <!-- Tab13: 局内存档/回溯 -->
            <TabItem Header="{DynamicResource Tab12.Header}" Tag="&#xE74E;">
                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="10" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource ContentBorderBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  CanContentScroll="False">
                        <!-- ★ 2026-09-25 统一页骨架：页头 + 卡片（原为 Label+Rectangle 手画标题、控件贴左） -->
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                                <TextBlock Text="{DynamicResource Tab12.Header}" Style="{DynamicResource PageTitleText}"
                                           Margin="2,0,0,10" />
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <hc:ElementGroup Orientation="Horizontal" Layout="Stack"
                                                         HorizontalAlignment="Left"
                                                         Style="{DynamicResource ElementGroupSolid}">
                                            <Button Content="{DynamicResource Tab12.ManualSnapshot}"
                                                    Command="{Binding ManualSnapshotCommand}"
                                                    Height="30" Width="200" />
                                            <Button Content="{DynamicResource Tab12.RestoreLast}"
                                                    Command="{Binding RestoreLastSnapshotCommand}"
                                                    Height="30" Width="200" />
                                        </hc:ElementGroup>
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="{DynamicResource Tab12.SnapshotInfoHeader}"
                                                       Style="{DynamicResource FieldLabel}" Width="200" />
                                            <Button Content="{DynamicResource Tab12.RefreshSnapshotInfo}"
                                                    Command="{Binding RefreshSnapshotInfoCommand}" />
                                        </StackPanel>
                                        <!-- 快照正文：占满卡片宽度（原为固定 560 宽） -->
                                        <TextBox Text="{Binding SnapshotInfo}" Height="220"
                                                 FontFamily="Consolas" FontSize="12"
                                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab14: 诸神：进化 -->
            <TabItem Header="{DynamicResource Tab13.Header}" Tag="&#xE945;">
                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="10" Background="{DynamicResource ContentBackgroundBrush}" BorderBrush="{DynamicResource ContentBorderBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  CanContentScroll="False">
                        <!-- ★ 2026-09-25 统一页骨架：页头 + 分组小标题（原为 Label+Rectangle 手画标题 + 粗体 Label 分组） -->
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                                <TextBlock Text="{DynamicResource Tab13.Header}" Style="{DynamicResource PageTitleText}"
                                           Margin="2,0,0,10" />
                                <!-- 页面说明：说明条容器（浅底 + 信息色描边），换行由外层网格宽度保证 -->
                                <Border Style="{DynamicResource NoticeBanner}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Tab13.Description}"
                                                   Style="{DynamicResource SecondaryText}" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{DynamicResource Tab13.Section.Refresh}" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,4,0,12">
                                <CheckBox IsChecked="{Binding GodEvolutionUnlimitedRefresh}" MinHeight="26" Margin="10,0,16,0"
                                          Content="{DynamicResource Tab13.UnlimitedRefresh}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <CheckBox IsChecked="{Binding GodEvolutionFreeUpgradeQuality}" MinHeight="26" Margin="0,0,16,0"
                                          Content="{DynamicResource Tab13.FreeUpgradeQuality}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <CheckBox IsChecked="{Binding GodEvolutionRefreshCountEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.RefreshCount}" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionRefreshCountEnabled}" Minimum="0" Maximum="99999999"
                                                  Value="{Binding GodEvolutionRefreshCount}" Width="120" Height="28" Margin="0,0,0,0" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Tab13.Section.Attributes}" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,4,0,12">
                                <CheckBox IsChecked="{Binding GodEvolutionLuckyEnabled}" MinHeight="26" Margin="10,0,8,0"
                                          Content="{DynamicResource Tab13.Lucky}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <!-- #2 幸运值须支持负数：去掉 Minimum="0"，允许输入负值（负数=降低词条出现率） -->
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionLuckyEnabled}" Maximum="9999" DecimalPlaces="2"
                                                  Value="{Binding GodEvolutionLucky}" Width="100" Height="28" Margin="0,0,16,0" />
                                <CheckBox IsChecked="{Binding GodEvolutionDifficultyEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.Difficulty}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionDifficultyEnabled}" Minimum="0" Maximum="99"
                                                  Value="{Binding GodEvolutionDifficulty}" Width="80" Height="28" Margin="0,0,16,0" />
                                <CheckBox IsChecked="{Binding GodEvolutionMaxPlantCountEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.MaxPlantCount}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionMaxPlantCountEnabled}" Minimum="1" Maximum="999"
                                                  Value="{Binding GodEvolutionMaxPlantCount}" Width="80" Height="28" Margin="0,0,16,0" />
                                <CheckBox IsChecked="{Binding GodEvolutionOptionCountEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.OptionCount}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionOptionCountEnabled}" Minimum="1" Maximum="10"
                                                  Value="{Binding GodEvolutionOptionCount}" Width="80" Height="28" Margin="0,0,16,0" />
                                <CheckBox IsChecked="{Binding GodEvolutionUpgradeBuffChanceEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.UpgradeBuffChance}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionUpgradeBuffChanceEnabled}" Minimum="0" Maximum="999999"
                                                  Value="{Binding GodEvolutionUpgradeBuffChance}" Width="100" Height="28" />
                            </WrapPanel>
                            <WrapPanel Margin="10,0,0,12">
                                <CheckBox IsChecked="{Binding GodEvolutionSuperUpgrade}" MinHeight="26" Margin="0,0,16,0"
                                          Content="{DynamicResource Tab13.SuperUpgrade}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <CheckBox IsChecked="{Binding GodEvolutionForceSuperQuality}" MinHeight="26" Margin="0,0,16,0"
                                          Content="{DynamicResource Tab13.ForceSuperQuality}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <CheckBox IsChecked="{Binding GodEvolutionUncrashable}" MinHeight="26" Margin="0,0,16,0"
                                          Content="{DynamicResource Tab13.Uncrashable}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <CheckBox IsChecked="{Binding GodEvolutionDamageMultiplierEnabled}" MinHeight="26" Margin="0,0,8,0"
                                          Content="{DynamicResource Tab13.DamageMultiplier}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionDamageMultiplierEnabled}" Minimum="0.1" Maximum="100" DecimalPlaces="2"
                                                  Value="{Binding GodEvolutionDamageMultiplier}" Width="100" Height="28" Increment="0.1" />
                            </WrapPanel>

                            <TextBlock Text="{DynamicResource Tab13.Section.Quality}" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,4,0,12">
                                <CheckBox IsChecked="{Binding GodEvolutionQualityWeightEnabled}" MinHeight="26" Margin="10,0,16,0"
                                          Content="{DynamicResource Tab13.QualityWeightEnabled}" Foreground="{DynamicResource TextForegroundBrush}" />
                                <Label Content="{DynamicResource Tab13.QualityDefault}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionQualityWeightEnabled}" Minimum="0" Maximum="9999" DecimalPlaces="1"
                                                  Value="{Binding GodEvolutionQualityDefault}" Width="80" Height="28" Margin="4,0,12,0" />
                                <Label Content="{DynamicResource Tab13.QualitySilver}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionQualityWeightEnabled}" Minimum="0" Maximum="9999" DecimalPlaces="1"
                                                  Value="{Binding GodEvolutionQualitySilver}" Width="80" Height="28" Margin="4,0,12,0" />
                                <Label Content="{DynamicResource Tab13.QualityGold}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionQualityWeightEnabled}" Minimum="0" Maximum="9999" DecimalPlaces="1"
                                                  Value="{Binding GodEvolutionQualityGold}" Width="80" Height="28" Margin="4,0,12,0" />
                                <Label Content="{DynamicResource Tab13.QualityDiamond}" VerticalAlignment="Center" Foreground="{DynamicResource TextForegroundBrush}" />
                                <hc:NumericUpDown IsEnabled="{Binding GodEvolutionQualityWeightEnabled}" Minimum="0" Maximum="9999" DecimalPlaces="1"
                                                  Value="{Binding GodEvolutionQualityDiamond}" Width="80" Height="28" Margin="4,0,0,0" />
                            </WrapPanel>
                            <TextBlock Text="{DynamicResource Tab13.QualityHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextForegroundBrush}" Margin="10,0,0,12" Opacity="0.75" FontSize="12" />

                            <!-- 诸神进化新增功能（曾误放在 全局特性修改>其他特性 折叠组，现迁回本页）：
                                 试炼/战术词条概率提升、隐藏难度、一键解锁、诸神币 -->
                            <TextBlock Text="{DynamicResource Tab13.Section.UnlockBoost}" Style="{DynamicResource SectionHeaderText}" />
                            <WrapPanel Margin="0,4,0,4">
                                <CheckBox x:Name="GodEvolutionForceMissionBuff"
                                          IsChecked="{Binding GodEvolutionForceMissionBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceMissionBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceMissionBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceTacticalBuff"
                                          IsChecked="{Binding GodEvolutionForceTacticalBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceTacticalBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceTacticalBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionCheatHard"
                                          IsChecked="{Binding GodEvolutionCheatHard}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionCheatHard}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionCheatHard.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceExpertBuff"
                                          IsChecked="{Binding GodEvolutionForceExpertBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceExpertBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceExpertBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceStarUpBuff"
                                          IsChecked="{Binding GodEvolutionForceStarUpBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceStarUpBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceStarUpBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceMutationBuff"
                                          IsChecked="{Binding GodEvolutionForceMutationBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceMutationBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceMutationBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceIridescentBuff"
                                          IsChecked="{Binding GodEvolutionForceIridescentBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceIridescentBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceIridescentBuff.Tooltip}" />
                                <CheckBox x:Name="GodEvolutionForceRandomBuff"
                                          IsChecked="{Binding GodEvolutionForceRandomBuff}"
                                          Content="{DynamicResource Tab1.Page7.GodEvolutionForceRandomBuff}" MinHeight="26"
                                          VerticalAlignment="Top" Foreground="{DynamicResource TextForegroundBrush}" BorderThickness="1"
                                          HorizontalAlignment="Left" Margin="0,0,10,0"
                                          ToolTip="{DynamicResource Tab1.Page7.GodEvolutionForceRandomBuff.Tooltip}" />
                            </WrapPanel>
                            <StackPanel Style="{DynamicResource CardRowLast}">
                                <TextBlock Text="{DynamicResource Tab1.Page7.SetGodCoin}" Style="{DynamicResource FieldLabel}"
                                           Width="120" ToolTip="{DynamicResource Tab1.Page7.SetGodCoin.Tooltip}" />
                                <TextBox Width="110" Height="28" VerticalAlignment="Center"
                                         Text="{Binding NewGodCoin, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="{DynamicResource Tab1.Page7.ApplyGodCoin}"
                                        Command="{Binding SetGodCoinCommand}"
                                        ToolTip="{DynamicResource Tab1.Page7.ApplyGodCoin.Tooltip}"
                                        Style="{DynamicResource ActionButton}" Margin="12,0,8,0" />
                                <Button Content="{DynamicResource Tab1.Page7.GodEvolutionUnlockAll}"
                                        Command="{Binding GodEvolutionUnlockAllCommand}"
                                        ToolTip="{DynamicResource Tab1.Page7.GodEvolutionUnlockAll.Tooltip}"
                                        Style="{DynamicResource ActionButtonLast}" Margin="0" />
                            </StackPanel>

                            <!-- 应用 / 恢复默认：单独一张卡片收口 -->
                            <Border Style="{DynamicResource SettingsCard}">
                                <hc:ElementGroup Orientation="Horizontal" Layout="Stack" HorizontalAlignment="Left" Style="{DynamicResource ElementGroupSolid}">
                                    <Button Content="{DynamicResource Tab13.ApplyNow}" Command="{Binding ApplyGodEvolutionNowCommand}" Height="30" Width="160" Style="{DynamicResource AccentButtonStyle}" />
                                    <Button Content="{DynamicResource Tab13.ResetDefaults}" Command="{Binding ResetGodEvolutionDefaultsCommand}" Height="30" Width="160" />
                                </hc:ElementGroup>
                            </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 关于修改器覆盖层（5.3.1 #3）：窗口内嵌弹层（参照下方启动加载遮罩的结构），不新开 Window、不新开 Tab -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="9998"
              Background="#66000000"
              Visibility="{Binding IsAboutOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="440" Padding="24" CornerRadius="8"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource ContentBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.Title}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About.GameVersion}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Static local:ModifierVersion.GameVersion}"
                                   Foreground="{DynamicResource TextForegroundBrush}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About.ModifierVersion}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Static local:ModifierVersion.Version}"
                                   Foreground="{DynamicResource TextForegroundBrush}" />
                    </Grid>
                    <!-- 许可证一行：悬停提示引导到 Tab7 既有许可证 Expander（全文在那里） -->
                    <Grid Margin="0,0,0,8" ToolTip="{DynamicResource Tab7.License}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource About.License}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" />
                        <TextBlock Grid.Column="1" Text="Apache-2.0"
                                   Foreground="{DynamicResource TextForegroundBrush}" />
                    </Grid>
                    <!-- 作者署名（专有名词，不进 Lang） -->
                    <TextBlock Text="梧萱梦汐X · infinite75 · 听雨夜荷"
                               Foreground="{DynamicResource TextForegroundBrush}" Opacity="0.85"
                               HorizontalAlignment="Center" Margin="0,12,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Content="{DynamicResource About.Close}" Command="{Binding ShowAboutCommand}"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Padding="20,4" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Startup loading overlay: hidden after InitData arrives -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="9999"
              Background="#88000000"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Width="320" Padding="20" CornerRadius="8"
                    Background="{DynamicResource ContentBackgroundBrush}"
                    BorderBrush="{DynamicResource ContentBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="正在加载数据…"
                               FontSize="16"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <ProgressBar Height="10" IsIndeterminate="True" />
                    <TextBlock Text="首次启动会稍慢，请稍候。"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               Opacity="0.8"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
