<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:PVZRHTools"
    xmlns:ctrl="clr-namespace:PVZRHTools.Controls"
    xmlns:conv="clr-namespace:PVZRHTools.Converters"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:fh="clr-namespace:FastHotKeyForWPF;assembly=FastHotKeyForWPF"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Class="PVZRHTools.MainWindow"
    mc:Ignorable="d"
    Height="760" Width="1200" MinHeight="200" MinWidth="900"
    Icon="./PVZRHTools/icon.ico" WindowStyle="None" Background="{DynamicResource WindowBackdropBrush}"
    Foreground="{DynamicResource WindowForegroundBrush}" BorderThickness="1" UseLayoutRounding="False"
    ResizeMode="CanResizeWithGrip" d:DataContext="{x:Type local:ModifierViewModel}"
    AllowsTransparency="False">
    <Window.Resources>
        <ObjectDataProvider x:Key="KeyCodeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:KeyCode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:FirstCharConverter x:Key="FirstCharConverter" />
        <!-- TMP 富文本渲染模板（5.3.1 #2）：词条 DataGrid 单元格与 ComboBox 下拉项共用 -->
        <DataTemplate x:Key="TmpTextTemplate">
            <ctrl:TmpTextBlock Markup="{Binding TravelBuff.Text}" TextWrapping="Wrap" />
        </DataTemplate>
    </Window.Resources>
    <Window.BorderBrush>
        <DynamicResource ResourceKey="WindowBorderBrush"/>
    </Window.BorderBrush>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Grid.Row="0" PreviewMouseDown="TitleBar_PreviewMouseDown" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <!-- ★ 2026-09-24：右侧「收起侧栏 + 最小化」按钮区的**占位列**（同层 StackPanel 覆盖在此列上方）。
                     作用：让居中的标题只使用「图标与按钮之间」的真实空档，
                     否则拉满整条的标题会把长文案的尾部塞到按钮下面（实测被按钮压掉尾字符）。 -->
                <ColumnDefinition Width="196"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="inf75" Grid.Column="0" Source="/PVZRHTools/icon.png" Stretch="Uniform" 
                   Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
            <Border Grid.Column="1" x:Name="TitleBarBorder" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,0,0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <!-- ★ 2026-09-24：标题改为**在可用空档内自适应居中**（用户要求「顶格标题想要自适应居中」）。
                     做法：Label 撑满本列（不含右侧预留列）并把内容置中 ——
                       文字短 → 落在图标与按钮之间的正中；文字长 → 在本列内自动裁剪，不再被按钮压住。
                     原来 HorizontalAlignment="Left" 是顶格，用户要的就是改掉那个。 -->
                <Label x:Name="WindowTitle" Content="" HorizontalAlignment="Stretch" Height="44" 
                       HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource TitleForegroundBrush}" FontSize="22" FontWeight="SemiBold"
                       Style="{DynamicResource LabelBaseStyle}" />
            </Border>
        </Grid>
        <!-- 侧栏收起切换（5.3.1 #5 收起半边）+ 最小化按钮（原「关于修改器」入口已迁至杂项 Tab7）：
             与 TitleBar 同层覆盖在右侧，避免落入其 DragMove 处理器 -->
        <StackPanel Grid.Row="0" Panel.ZIndex="10" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
            <!-- ★ 2026-09-25 收起侧栏按钮图标化（侧边栏重设计配套）：文字标签 → chevron 箭头，
                 展开态箭头指左（点击收进去）、收起态指右（点击展开出来），180° 旋转切换；
                 字形 E76C 已程序化验证存在，ToolTip 沿用原「收起侧栏/展开侧栏」文案。 -->
            <Button Command="{Binding ToggleSidebarCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Height="28" Width="34" Padding="0" RenderTransformOrigin="0.5,0.5">
                <Button.Content>
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button.Content>
                <Button.Style>
                    <Style TargetType="Button">
                        <!-- ★ 内联 Style 会替换 SimpleTheme 的隐式 Button 样式，必须显式补主题令牌，
                             否则深色下回落到 HandyControl 烘死的浅色画笔（白底白字）。 -->
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Width" Value="34" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="ToolTip" Value="{DynamicResource Sidebar.Collapse}" />
                        <!-- 展开态：箭头指左（旋转 180°） -->
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <RotateTransform Angle="180" />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter x:Name="Cp"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          RecognizesAccessKey="True"
                                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                <Setter Property="ToolTip" Value="{DynamicResource Sidebar.Expand}" />
                                <!-- 收起态：箭头指右（不旋转） -->
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="0" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- 最小化（占原「关于修改器」入口位；关于改由杂项页按钮打开同一覆盖层） -->
            <Button Content="&#x2014;"
                    Click="MinimizeButton_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="28" Padding="14,0" FontSize="14"
                    ToolTip="{DynamicResource Window.Minimize}" />
        </StackPanel>
        <TabControl x:Name="MainTabControl" Grid.Row="1" TabStripPlacement="Left" BorderBrush="{DynamicResource TabControlBorderBrush}" Background="{DynamicResource TabControlBackgroundBrush}"
                    SelectionChanged="MainTabControl_SelectionChanged"
                    BorderThickness="0,0,0,0">
            <!-- ★ 2026-09-25 侧边栏导航重设计（参考参考版 PVZRHTools-master 的 Ursa NavMenu）：
                 ① 图标 + 文字双元素：图标取自各 TabItem 的 Tag，字体 Segoe MDL2 Assets（全部码位已程序化验证存在）；
                 ② 悬停胶囊底色；选中态 = 左侧 3px 强调条 + 强调底色 + 强调色文字；
                 ③ 收起时只留图标：ToolTipService.IsEnabled 绑定 SidebarCollapsed —— 展开不弹提示、收起才弹全名；
                 ④ 收起/展开用标题的 MaxWidth/Opacity 双动画平滑过渡，左 strip 宽度随内容自适应
                    ⇒ 整条侧栏平滑变宽窄（旧版是「全文↔首字」硬切）。
                 刻意不 BasedOn HandyControl 隐式 TabItem 样式：ItemContainerStyle 是显式 Style，
                 隐式样式整条被替换，自定义模板即最终外观（旧的「方块堆叠」观感即来自 HC 隐式样式）。 -->
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                        ToolTip="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                        ToolTipService.IsEnabled="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Grid Height="36">
                                        <!-- 选中指示条：贴左缘 3px 圆角强调条 -->
                                        <Rectangle x:Name="SelBar" Width="3" RadiusX="1.5" RadiusY="1.5" Height="18"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                                   Fill="{DynamicResource LabelForegroundBrush}" Visibility="Collapsed" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,14,0">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"
                                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="{DynamicResource LabelForegroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <!-- 标题：MaxWidth/Opacity 动画驱动左 strip 宽度平滑收放 -->
                                <TextBlock Text="{Binding}" FontSize="13.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="MaxWidth" Value="180" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <!-- 状态值 Setter（兜底/初始态）；平滑过渡动画在 code-behind
                                                     AnimateSidebarLabels 里用 BeginAnimation 驱动。
                                                     ★ 为什么不写 EnterActions：本机 .NET 8 XAML 编译器对
                                                     <EnterActions> 标签整体报 MC3074（最小工程空标签复现，
                                                     EventTrigger 正常）⇒ 动画只能放 code-behind。 -->
                                                <DataTrigger Binding="{Binding DataContext.SidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="MaxWidth" Value="0" />
                                                    <Setter Property="Opacity" Value="0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
            <TabItem Header="{DynamicResource Tab0.Header}" Tag="&#xE80F;">
                <!-- ★ 2026-09-26 毛玻璃：内容宿主改**半透明**（原 ContentBackgroundBrush 是不透明白/深灰）
                     —— 这是让卡片"透出窗口渐变"的关键一层：宿主若不透明，卡片的半透明就无从体现。 -->
                <Border x:Name="Tab0ContentBorder" Margin="0,8,0,0" BorderThickness="1" CornerRadius="12" Background="{DynamicResource GlassHostBrush}" BorderBrush="{DynamicResource ContentBorderBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  CanContentScroll="False">
                        <!-- ★ 2026-09-25 常用功能页排版重做：
                             旧版病根：①控件直接堆在 StackPanel 里、零内边距、全部贴左贴顶；
                              ②分组不靠标题而靠 Rectangle 横线硬画（宽度还写死 323/552）；
                              ③复选框高矮不一（Height=21）且靠 Margin=10,0,0,0 手排；
                              ④同一行里混排「复选框 + 数值框 + 按钮」，视觉层级完全塌陷。
                             现改为「页头 + 分组标题 + 卡片」结构，控件尺寸与留白统一走 SimpleTheme 的排版件。 -->
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                                <!-- ===== 页头：页面标题 + 语言选择 ===== -->
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Tab0.Header}" Style="{DynamicResource PageTitleText}" />
                                    <hc:ComboBox hc:TitleElement.MinWidth="120" hc:TitleElement.TitlePlacement="Left"
                                                 hc:TitleElement.Title="语言/Language/Язык" Height="30" Width="255"
                                                 Style="{DynamicResource ComboBoxExtend}"
                                                 SelectionChanged="ComboBox_SelectionChanged"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBoxItem Content="简体中文" IsSelected="True" />
                                        <ComboBoxItem Content="English" />
                                        <ComboBoxItem Content="Русский" />
                                    </hc:ComboBox>
                                </Grid>

                                <!-- ===== 基本特性 ===== -->
                                <TextBlock Text="{DynamicResource Tab1.Page1.Header}" Style="{DynamicResource SectionHeaderText}" />
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                <WrapPanel Orientation="Horizontal">
                                    <CheckBox x:Name="DeveloperMode" Content="{DynamicResource Tab1.Page1.DevMode}"
                                              IsChecked="{Binding DeveloperMode}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="GloveNoCD" Content="{DynamicResource Tab1.Page1.GloveNoCD}"
                                              IsChecked="{Binding GloveNoCD}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="HammerNoCD" Content="{DynamicResource Tab1.Page1.HammerNoCD}"
                                              IsChecked="{Binding HammerNoCD}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="PlantingNoCD" Content="{DynamicResource Tab1.Page1.PlantingNoCD}"
                                              IsChecked="{Binding PlantingNoCD}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="FreePlanting" Content="{DynamicResource Tab1.Page1.FreePlanting}"
                                              IsChecked="{Binding FreePlanting}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="UnlockAllFusions" Content="{DynamicResource Tab1.Page1.UnlockAllFusions}"
                                              IsChecked="{Binding UnlockAllFusions}" Style="{DynamicResource OptionCheckBox}" />
                                    <CheckBox x:Name="WheelNoCD" Content="{DynamicResource Tab1.Page1.WheelNoCD}"
                                              IsChecked="{Binding WheelNoCD}" Style="{DynamicResource OptionCheckBox}" />
                                </WrapPanel>

                                <!-- 冷却锁定：三项结构完全一致 ⇒ 用固定标签宽对齐数值框 -->
                                <Border Style="{DynamicResource CardDivider}" />
                                <StackPanel Style="{DynamicResource CardRow}">
                                    <CheckBox x:Name="WheelFullCDEnabled" Content="{DynamicResource Tab1.Page1.LockWheelCD}"
                                              IsChecked="{Binding WheelFullCDEnabled}" Width="180" Margin="0"
                                              Style="{DynamicResource CardCheckBox}" />
                                    <hc:NumericUpDown IsEnabled="{Binding WheelFullCDEnabled}" DecimalPlaces="1"
                                                      x:Name="WheelFullCD" Width="96" Height="28"
                                                      VerticalAlignment="Center"
                                                      Value="{Binding WheelFullCD}" Increment="0.1" Minimum="0"
                                                      SelectionOpacity="0.1" />
                                </StackPanel>
                                <StackPanel Style="{DynamicResource CardRow}">
                                    <CheckBox x:Name="GloveFullCDEnabled" Content="{DynamicResource Tab1.Page1.LockGloveCD}"
                                              IsChecked="{Binding GloveFullCDEnabled}" Width="180" Margin="0"
                                              Style="{DynamicResource CardCheckBox}" />
                                    <hc:NumericUpDown IsEnabled="{Binding GloveFullCDEnabled}" DecimalPlaces="1"
                                                      x:Name="GloveFullCD" Width="96" Height="28"
                                                      VerticalAlignment="Center"
                                                      Value="{Binding GloveFullCD}" Increment="0.1" Minimum="0"
                                                      SelectionOpacity="0.1" />
                                </StackPanel>
                                <StackPanel Style="{DynamicResource CardRowLast}">
                                    <CheckBox x:Name="HammerFullCDEnabled" Content="{DynamicResource Tab1.Page1.LockHammerCD}"
                                              IsChecked="{Binding HammerFullCDEnabled}" Width="180" Margin="0"
                                              Style="{DynamicResource CardCheckBox}" />
                                    <hc:NumericUpDown IsEnabled="{Binding HammerFullCDEnabled}" DecimalPlaces="1"
                                                      x:Name="HammerFullCD" Width="96" Height="28"
                                                      VerticalAlignment="Center"
                                                      Value="{Binding HammerFullCD}" Minimum="0"
                                                      Increment="0.1" SelectionOpacity="0.2" />
                                </StackPanel>
                                    </StackPanel>
                                </Border>

                                    <!-- 关卡特性附加 / 数值修改 / 布阵：并进同一张卡片，仅用小标签区分（不再是独立卡片） -->
                                    <Border Style="{DynamicResource CardDivider}" />
                                    <TextBlock Text="{DynamicResource Tab1.Page4.Header}" Style="{DynamicResource SectionHeaderText}" />
                                    <WrapPanel Margin="0,0,0,-6">
                                        <CheckBox x:Name="ColumnPlanting" Content="{DynamicResource Tab1.Page4.ColumnPlanting}"
                                                  IsChecked="{Binding ColumnPlanting}" Style="{DynamicResource OptionCheckBox}" />
                                        <CheckBox x:Name="SeedRain" Content="{DynamicResource Tab1.Page4.SeedRain}"
                                                  IsChecked="{Binding SeedRain}" Style="{DynamicResource OptionCheckBox}" />
                                        <CheckBox x:Name="RemoveFusionLimit" Content="{DynamicResource Tab1.Page4.RemoveFusionLimit}"
                                                  IsChecked="{Binding RemoveFusionLimit}" Style="{DynamicResource OptionCheckBox}"
                                                  ToolTip="{DynamicResource Tab1.Page4.RemoveFusionLimit.Tooltip}" />
                                        <CheckBox x:Name="ScaredyDream" Content="{DynamicResource Tab1.Page4.ScaredyDream}"
                                                  IsChecked="{Binding ScaredyDream}" Style="{DynamicResource OptionCheckBox}" />
                                    </WrapPanel>
                                <!-- 数值修改：并进上面那张卡片 -->
                                <Border Style="{DynamicResource CardDivider}" />
                                <TextBlock Text="{DynamicResource Tab1.Page3.Header}" Style="{DynamicResource SectionHeaderText}" />
                                <hc:NumericUpDown hc:TitleElement.TitlePlacement="Left"
                                                  hc:TitleElement.Title="{DynamicResource Tab1.Page1.NextWaveCD}"
                                                  hc:TitleElement.TitleWidth="120" DecimalPlaces="1"
                                                  x:Name="NewZombieUpdateCD" Width="240" Height="28"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" Margin="0,0,0,7"
                                                          Value="{Binding NewZombieUpdateCD}" Minimum="0"
                                                          SelectionOpacity="0.2"
                                                          Style="{DynamicResource NumericUpDownExtend}"
                                                          ToolTip="{DynamicResource Tab1.Page1.NextWaveCD.Tootip}"
                                                          Maximum="30" />
                                        <StackPanel Style="{DynamicResource CardRowLast}">
                                            <CheckBox Content="{DynamicResource Tab1.Page1.GameSpeedEnabled}"
                                                      IsChecked="{Binding GameSpeedEnabled,Mode=TwoWay}"
                                                      Margin="0,0,16,0" Style="{DynamicResource CardCheckBox}" />
                                            <hc:NumericUpDown hc:TitleElement.TitlePlacement="Left"
                                                              hc:TitleElement.Title="{DynamicResource Tab1.Page1.GameSpeed}"
                                                              hc:TitleElement.TitleWidth="90"
                                                              hc:TitleElement.Foreground="{DynamicResource TextForegroundBrush}"
                                                              DecimalPlaces="3"
                                                              x:Name="GameSpeed" Width="200" Height="28"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Value="{Binding GameSpeed,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                                              Increment="0.1" Minimum="0" SelectionOpacity="0.1" Maximum="16"
                                                              IsEnabled="{Binding GameSpeedEnabled}">
                                                <!-- ★ 2026-09-24：禁用态可读性修正（用户实测「游戏速度」文字看不清）。
                                                     HandyControl 模板在 IsEnabled=False 时把内容压到很低的不透明度，
                                                     深色底上几乎不可见（实测该数值框 enabled=False）。
                                                     这里只对该控件**抬高禁用态不透明度**，不碰模板/尺寸，
                                                     避免触发本工程已记录的「给 HC 输入类控件挂隐式样式会整片消失」问题。 -->
                                                <hc:NumericUpDown.Style>
                                                    <!-- ★ BasedOn 是 Style 的普通 CLR 属性，**只接受 StaticResource**，
                                                         写 DynamicResource 会抛 XamlParseException（启动即崩，2026-09-24 实测）。
                                                         键 NumericUpDownExtend 来自 hc:Theme（App 级合并），解析期可取到。 -->
                                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownExtend}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </hc:NumericUpDown.Style>
                                            </hc:NumericUpDown>
                                            <Button x:Name="UnlockAllPlants"
                                                    Content="{DynamicResource Tab1.Page1.UnlockAllPlants}"
                                                    Command="{Binding UnlockAllPlantsCommand}"
                                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                                    ToolTip="{DynamicResource Tab1.Page1.UnlockAllPlants.Tooltip}" />
                                        </StackPanel>
                                    <!-- 布阵：并进同一张卡片 -->
                                    <Border Style="{DynamicResource CardDivider}" />
                                    <TextBlock Text="{DynamicResource Tab2.Page1.Header}" Style="{DynamicResource SectionHeaderText}" />
                                    <TextBlock Text="{DynamicResource Tab2.Page1.Description}" Style="{DynamicResource SecondaryText}"
                                               Margin="2,0,0,7" />
                                    <StackPanel Style="{DynamicResource CardRow}">
                                        <hc:NumericUpDown DecimalPlaces="0" hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.Title="{DynamicResource Tab2.Page1.Row}"
                                                          hc:TitleElement.TitleWidth="35" x:Name="Row"
                                                          VerticalAlignment="Center" Width="104" Height="28"
                                                          Value="{Binding Row}" Maximum="12" Minimum="0"
                                                          Style="{DynamicResource NumericUpDownExtend}" />
                                        <hc:NumericUpDown DecimalPlaces="0" hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.Title="{DynamicResource Tab2.Page1.Col}"
                                                          hc:TitleElement.TitleWidth="30" x:Name="Column"
                                                          VerticalAlignment="Center" Width="104" Height="28" Margin="12,0,0,0"
                                                          Value="{Binding Col}" Maximum="24" Minimum="0"
                                                          Style="{DynamicResource NumericUpDownExtend}" />
                                        <hc:NumericUpDown DecimalPlaces="0" hc:TitleElement.TitlePlacement="Left"
                                                          hc:TitleElement.Title="{DynamicResource Tab2.Page1.RepeatTimes}"
                                                          hc:TitleElement.TitleWidth="100" x:Name="Times"
                                                          VerticalAlignment="Center" Width="190" Height="28" Margin="12,0,0,0"
                                                          Value="{Binding Times}" Maximum="50" Minimum="1"
                                                          Style="{DynamicResource NumericUpDownExtend}" />
                                        <CheckBox x:Name="PvPPotRange" Content="{DynamicResource Tab2.Page1.PvPPotRange}"
                                                  IsChecked="{Binding PvPPotRange}" Style="{DynamicResource OptionCheckBox}"
                                                  MinHeight="26" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{DynamicResource CardDivider}" />

                                    <!-- 生成植物：按钮 + 类型下拉 + 卡片/礼盒（HandyControl 分段控件，保持原有拼合写法） -->
                                    <hc:ElementGroup Orientation="Horizontal" Layout="Stack"
                                                     HorizontalAlignment="Left" Style="{DynamicResource ElementGroupSolid}"
                                                     Margin="0,0,0,8">
                                        <Button x:Name="CreatePlant" Content="{DynamicResource Tab2.Page1.CreatePlant}"
                                                HorizontalAlignment="Left" Height="30" VerticalAlignment="Center" Width="68"
                                                Command="{Binding CreatePlantCommand}"
                                                Click="CreatePlant_Click"
                                                Style="{DynamicResource ButtonGroupItemHorizontalFirst}" />
                                        <ComboBox x:Name="PlantType" SelectedValuePath="Key" DisplayMemberPath="Value"
                                                  ItemsSource="{Binding Plants2}" SelectedValue="{Binding PlantType}"
                                                  Style="{DynamicResource ComboBoxExtend}" Width="150"
                                                  HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                                  Margin="-34,0,0,0" VerticalAlignment="Center" Height="30"
                                                  IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value"
                                                  Loaded="PlantType_Loaded" GotFocus="PlantType_GotFocus" LostFocus="PlantType_LostFocus"
                                                  PreviewKeyDown="PlantType_PreviewKeyDown" PreviewTextInput="PlantType_PreviewTextInput"
                                                  KeyDown="PlantType_KeyDown" TextInput="PlantType_TextInput" />
                                        <Button x:Name="CreateCard" Content="{DynamicResource Tab2.Page1.CreateCard}"
                                                Width="122" Command="{Binding CreateCardCommand}" Height="30" />
                                        <Button x:Name="SimplePresents"
                                                Content="{DynamicResource Tab2.Page1.SimplePresents}" Width="262"
                                                Command="{Binding SimplePresentsCommand}" Height="30" />
                                    </hc:ElementGroup>
                                    <!-- 生成僵尸 -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <hc:ElementGroup Orientation="Horizontal" Layout="Stack" Width="217"
                                                         HorizontalAlignment="Left">
                                            <Button x:Name="CreateZombie"
                                                    Content="{DynamicResource Tab2.Page1.CreateZombie}"
                                                    HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"
                                                    Width="68" Command="{Binding CreateZombieCommand}"
                                                    Click="CreateZombie_Click" />
                                            <ComboBox x:Name="ZombieType" HorizontalAlignment="Left" Height="30"
                                                      VerticalAlignment="Center" Width="150" SelectedValuePath="Key"
                                                      DisplayMemberPath="Value" ItemsSource="{Binding Zombies}"
                                                      SelectedValue="{Binding ZombieType}"
                                                      Style="{DynamicResource ComboBoxExtend}"
                                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value"
                                                      Loaded="ZombieType_Loaded" GotFocus="ZombieType_GotFocus" LostFocus="ZombieType_LostFocus"
                                                      PreviewKeyDown="ZombieType_PreviewKeyDown" PreviewTextInput="ZombieType_PreviewTextInput"
                                                      KeyDown="ZombieType_KeyDown" TextInput="ZombieType_TextInput" />
                                        </hc:ElementGroup>
                                        <CheckBox x:Name="IsMindCtrl" Content="{DynamicResource Tab2.Page1.IsMindCtrl}"
                                                  IsChecked="{Binding IsMindCtrl}" Style="{DynamicResource OptionCheckBox}"
                                                  MinHeight="26" Margin="12,0,10,0" VerticalAlignment="Center" />
                                        <hc:ButtonGroup Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Button x:Name="PlantVase" Content="{DynamicResource Tab2.Page1.PlantVase}"
                                                    Command="{Binding PlantVaseCommand}"  />
                                            <Button x:Name="ZombieVase" Content="{DynamicResource Tab2.Page1.ZombieVase}"
                                                    Command="{Binding ZombieVaseCommand}"   />
                                        </hc:ButtonGroup>
                                        <Button x:Name="RandomVase" Content="{DynamicResource Tab2.Page1.RandomVase}"
                                                Command="{Binding RandomVaseCommand}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <!-- 生成物品 / 陨星 / 作弊按钮 -->
                                    <WrapPanel>
                                        <hc:ElementGroup Orientation="Horizontal" Layout="Stack" HorizontalAlignment="Left">
                                            <Button x:Name="CreateItem" Content="{DynamicResource Tab2.Page1.CreateItem}"
                                                    HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"
                                                    Width="68" Command="{Binding CreateItemCommand}" />
                                            <ComboBox x:Name="ItemType" HorizontalAlignment="Left" Height="30"
                                                      VerticalAlignment="Center" Width="150" SelectedValuePath="Key"
                                                      DisplayMemberPath="Value" SelectedValue="{Binding ItemType}"
                                                      Style="{DynamicResource ComboBoxExtend}"
                                                      ItemsSource="{Binding Items, Mode=OneWay}"
                                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value" />
                                        </hc:ElementGroup>
                                        <hc:ButtonGroup Height="30" Width="auto" Margin="0,0,10,0"
                                                        Style="{DynamicResource ButtonGroupSolid}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Left">
                                            <Button x:Name="CreatePassiveMateorite"
                                                    Content="{DynamicResource Tab2.Page1.CreatePassiveMateorite}"
                                                    HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"
                                                    Width="auto" Command="{Binding CreatePassiveMateoriteCommand}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalFirst}" />
                                            <Button x:Name="CreateActiveMateorite"
                                                    Content="{DynamicResource Tab2.Page1.CreateActiveMateorite}"
                                                    HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"
                                                    Width="auto" Command="{Binding CreateActiveMateoriteCommand}"
                                                    Style="{DynamicResource ButtonGroupItemDefault}" />
                                            <Button x:Name="CreateUltimateMateorite" HorizontalAlignment="Left" Height="30"
                                                    VerticalAlignment="Center" Width="auto"
                                                    Content="{DynamicResource Tab2.Page1.CreateUltimateMateorite}"
                                                    Command="{Binding CreateUltimateMateoriteCommand}"
                                                    Style="{DynamicResource ButtonGroupItemDefault}" />
                                            <Button x:Name="CreateSolarMeteorite"
                                                    Content="{DynamicResource Tab2.Page1.CreateSolarMeteorite}"
                                                    HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"
                                                    Width="auto" Command="{Binding CreateSolarMeteoriteCommand}"
                                                    ToolTip="{DynamicResource Tab2.Page1.CreateSolarMeteorite.Tooltip}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalLast}" />
                                        </hc:ButtonGroup>
                                        <Button x:Name="AbyssCheat" Content="{DynamicResource Tab0.AbyssCheat}"
                                                Command="{Binding AbyssCheatCommand}" VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="LoadCustomPlantData"
                                                Content="{DynamicResource Tab0.LoadCustomPlantData}"
                                                Command="{Binding LoadCustomPlantDataCommand}"
                                                VerticalAlignment="Center"
                                                ToolTip="{DynamicResource Tab0.LoadCustomPlantData.Tooltip}" />
                                    </WrapPanel>

                            <!-- 游戏状态调整 -->
                            <TextBlock Text="{DynamicResource Tab2.Page2.Header}" Style="{DynamicResource SectionHeaderText}" Margin="2,6,0,4" />
                            <Border Style="{DynamicResource SettingsCard}">
                            <StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <Button x:Name="ChangeSun" Content="{DynamicResource Tab2.Page2.ChangeSun}"
                                                    Command="{Binding SunCommand}" VerticalAlignment="Center"
                                                    Margin="0,0,12,0" />
                                            <hc:NumericUpDown DecimalPlaces="0" x:Name="Sun" Width="110" Height="28"
                                                              VerticalAlignment="Center"
                                                              Value="{Binding NewSun, ValidatesOnNotifyDataErrors=True}"
                                                              Increment="100" Maximum="2147483647" Minimum="0" />
                                            <CheckBox x:Name="LockSun" IsChecked="{Binding LockSun}"
                                                      Content="{DynamicResource Tab2.Page2.LockSun}"
                                                      Style="{DynamicResource OptionCheckBox}"
                                                      MinHeight="26" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Style="{DynamicResource CardRowLast}">
                                            <Button x:Name="ChangeMoney" Content="{DynamicResource Tab2.Page2.ChangeMoney}"
                                                    Command="{Binding MoneyCommand, ValidatesOnNotifyDataErrors=True}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <hc:NumericUpDown DecimalPlaces="0" x:Name="Money" Width="110" Height="28"
                                                              VerticalAlignment="Center"
                                                              Value="{Binding NewMoney}" Increment="100" Maximum="99999"
                                                              Minimum="0" />
                                            <CheckBox x:Name="LockMoney" IsChecked="{Binding LockMoney}"
                                                      Content="{DynamicResource Tab2.Page2.LockMoney}"
                                                      Style="{DynamicResource OptionCheckBox}"
                                                      MinHeight="26" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 波次与出怪：与前一张卡片共用「游戏状态调整」标题（不再另起分组） -->
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <Button x:Name="NextWave" Content="{DynamicResource Tab2.Page2.NextWave}"
                                                    Width="167" VerticalAlignment="Center"
                                                    Command="{Binding NextWaveCommand}" />
                                            <TextBox Width="80" Height="28" VerticalAlignment="Center" Margin="8,0,0,0"
                                                     Text="{Binding JumpWaveValue, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{DynamicResource Tab2.Page2.JumpWave.Tooltip}" />
                                            <Button x:Name="JumpWave" Content="{DynamicResource Tab2.Page2.JumpWave}"
                                                    Width="120" VerticalAlignment="Center" Margin="8,0,0,0"
                                                    Command="{Binding SetJumpWaveCommand}"
                                                    ToolTip="{DynamicResource Tab2.Page2.JumpWave.Tooltip}" />
                                        </StackPanel>
                                        <WrapPanel Margin="0,0,0,-6">
                                            <CheckBox x:Name="StopSummon" IsChecked="{Binding StopSummon}"
                                                      Content="{DynamicResource Tab2.Page2.StopSummon}"
                                                      Style="{DynamicResource OptionCheckBox}" />
                                            <CheckBox x:Name="NoFail" IsChecked="{Binding NoFail}"
                                                      Content="{DynamicResource Tab2.Page2.NoFail}"
                                                      Style="{DynamicResource OptionCheckBox}" />
                                            <CheckBox x:Name="UnlimitedRefresh" IsChecked="{Binding UnlimitedRefresh}"
                                                      Content="{DynamicResource Tab2.Page2.UnlimitedRefresh}"
                                                      Style="{DynamicResource OptionCheckBox}" />
                                            <CheckBox x:Name="UnlimitedScore" IsChecked="{Binding UnlimitedScore}"
                                                      Content="{DynamicResource Tab2.Page2.UnlimitedScore}"
                                                      Style="{DynamicResource OptionCheckBox}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 场地操作：清场/奖杯 与 小推车 -->
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <!-- 拆成两段（4+3）：7 个按钮并成一组时总宽会超过卡片内容宽（最小窗口下会顶出卡片） -->
                                        <hc:ButtonGroup Height="30" HorizontalAlignment="Left" Margin="0,0,0,7">
                                            <Button x:Name="ClearAllPlants"
                                                    Content="{DynamicResource Tab2.Page2.ClearAllPlants}"
                                                    Command="{Binding ClearAllPlantsCommand}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalFirst}" />
                                            <Button x:Name="KillAllZombies"
                                                    Content="{DynamicResource Tab2.Page2.KillAllZombies}"
                                                    Command="{Binding KillAllZombiesCommand}"
                                                    Style="{DynamicResource ButtonGroupItemDefault}" />
                                            <Button x:Name="ClearIce" Content="{DynamicResource Tab2.Page2.ClearIce}"
                                                    Command="{Binding ClearIceRoadsCommand}"
                                                    Style="{DynamicResource ButtonGroupItemDefault}" />
                                            <Button x:Name="MindCtrlAll" Content="{DynamicResource Tab2.Page2.MindCtrlAll}"
                                                    Command="{Binding MindCtrlCommand}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalLast}" />
                                        </hc:ButtonGroup>
                                        <hc:ButtonGroup Height="30" HorizontalAlignment="Left" Margin="0,0,0,7">
                                            <Button x:Name="ClearAllHoles" Content="{DynamicResource Tab2.Page2.ClearAllHoles}"
                                                    Command="{Binding ClearAllHolesCommand}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalFirst}" />
                                            <Button x:Name="SetAward" Content="{DynamicResource Tab2.Page2.SetAward}"
                                                    Command="{Binding SetAwardCommand}"
                                                    Style="{DynamicResource ButtonGroupItemDefault}" />
                                            <Button x:Name="DestroyAward" Content="{DynamicResource Tab2.Page2.DestroyAward}"
                                                    Command="{Binding DestroyAwardCommand}"
                                                    Style="{DynamicResource ButtonGroupItemHorizontalLast}" />
                                        </hc:ButtonGroup>
                                        <WrapPanel>
                                            <Button x:Name="CancelGameLose"
                                                    Content="{DynamicResource Tab0.CancelGameLose}"
                                                    Command="{Binding CancelGameLoseCommand}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0"
                                                    ToolTip="{DynamicResource Tab0.CancelGameLose.Tooltip}" />
                                            <hc:ButtonGroup Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Button x:Name="StartMower" Content="{DynamicResource Tab2.Page2.StartMower}"
                                                        Command="{Binding StartMowerCommand}" />
                                                <Button x:Name="CreateMower" Content="{DynamicResource Tab2.Page2.CreateMower}"
                                                        Command="{Binding CreateMowerCommand}"
                                                        ToolTip="{DynamicResource Tab2.Page2.CreateMower.Tooltip}" />
                                            </hc:ButtonGroup>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 关卡名称与字幕 -->
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <Button x:Name="ChangeLevelName"
                                                    Content="{DynamicResource Tab2.Page2.ChangeLevelName}"
                                                    VerticalAlignment="Center" Width="120"
                                                    Command="{Binding LevelNameCommand}" />
                                            <TextBox x:Name="LevelName" VerticalAlignment="Center"
                                                     Width="300" Height="28" Margin="12,0,0,0"
                                                     Text="{Binding NewLevelName}" />
                                        </StackPanel>
                                        <StackPanel Style="{DynamicResource CardRowLast}">
                                            <Button x:Name="ShowText" Content="{DynamicResource Tab2.Page2.ShowText}"
                                                    VerticalAlignment="Center" Width="120"
                                                    Command="{Binding ShowingTextCommand}" />
                                            <TextBox x:Name="Text" VerticalAlignment="Center"
                                                     Width="300" Height="28" Margin="12,0,0,0" Text="{Binding ShowText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 旗帜波词条 -->
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="FlagWaveBuffEnabled" IsChecked="{Binding FlagWaveBuffEnabled}"
                                                  Content="{DynamicResource Tab2.Page2.FlagWaveBuffEnabled}"
                                                  Style="{DynamicResource CardCheckBox}" />
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="{DynamicResource Tab2.Page2.FlagWaveBuffIds}"
                                                       Style="{DynamicResource FieldLabel}" Width="110" />
                                            <hc:CheckComboBox x:Name="FlagWaveBuffIdsComboBox"
                                                              ItemsSource="{Binding AllInGameBuffs}"
                                                              Width="400" SelectedValuePath="TravelBuff.Index"
                                                              ItemTemplate="{StaticResource TmpTextTemplate}"
                                                              IsSynchronizedWithCurrentItem="True"
                                                              IsTextSearchEnabled="True" TextSearch.TextPath="TravelBuff.Text"
                                                              SelectionChanged="FlagWaveBuffIdsComboBox_SelectionChanged"
                                                              MaxDropDownHeight="300" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="{DynamicResource Tab2.Page2.FlagWaveBuffOrderIds}"
                                                       Style="{DynamicResource FieldLabel}" Width="110" />
                                            <TextBox x:Name="FlagWaveBuffOrderIdsTextBox" Width="320" Height="28"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{DynamicResource Tab2.Page2.FlagWaveBuffOrderIds.Tooltip}" />
                                            <Button x:Name="FlagWaveBuffOrderApplyButton"
                                                    Content="{DynamicResource Tab2.Page2.FlagWaveBuffOrderIds.Apply}"
                                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Click="FlagWaveBuffOrderApplyButton_Click" />
                                        </StackPanel>
                                        <!-- 说明文字：包一层单列 * 的 Grid，保证在卡片内正常换行（StackPanel 会给子元素无限宽） -->
                                        <Grid Margin="110,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Tab2.Page2.FlagWaveBuffOrderIds.Hint}"
                                                       Style="{DynamicResource SecondaryText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 传送带植物类型 -->
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <CheckBox x:Name="ConveyBeltModify" IsChecked="{Binding ConveyBeltModify}"
                                                  Content="{DynamicResource Tab2.Page1.ConveyBeltModify}"
                                                  Style="{DynamicResource CardCheckBox}" />
                                        <hc:CheckComboBox x:Name="ConveyBeltTypes"
                                                          local:SelectedItemsExt.SelectedItems="{Binding ConveyBeltTypes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding Plants2}" HorizontalAlignment="Stretch"
                                                          MaxWidth="644" SelectedValuePath="Key" DisplayMemberPath="Value"
                                                          IsSynchronizedWithCurrentItem="True"
                                                          IsTextSearchEnabled="True" TextSearch.TextPath="Value" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ==================================================================
                 TabCustom：我的面板（2026-09-25 新增「自由度排版」功能区）
                 玩法：把常用功能收藏进来 + 上下调序 + 可选列数（自动/1/2/3）。
                 实现：每项由 CustomLayoutCatalog 的构建函数**独立实例化**一份绑定同 VM 的控件，
                       与来源页面互不影响（见 CustomLayoutCatalog.cs 顶部的设计说明）。
                 持久化：CustomPanelViewModel.Changed → ModifierViewModel.PersistCustomPanel（不受「保存设置」开关影响）。
                 ================================================================== -->
            <TabItem Header="{DynamicResource Custom.Tab.Header}" Tag="&#xE71D;">
                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  CanContentScroll="False">
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                                <TextBlock Text="{DynamicResource Custom.Tab.Header}" Style="{DynamicResource PageTitleText}"
                                           Margin="2,0,0,6" />
                                <TextBlock Text="{DynamicResource Custom.Page.Description}"
                                           Style="{DynamicResource SecondaryText}" Margin="2,0,0,10" />

                                <!-- ===== 添加功能 ===== -->
                                <TextBlock Text="{DynamicResource Custom.Picker.Header}" Style="{DynamicResource SectionHeaderText}" />
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel>
                                        <StackPanel Style="{DynamicResource CardRow}" DataContext="{Binding CustomPanel}">
                                            <!-- 文本搜索（2026-09-25：目录 175+ 项，靠下拉翻页找太慢）
                                                 输入即过滤候选（功能名 + 来源页名，忽略大小写） -->
                                            <TextBlock Text="{DynamicResource Custom.Picker.Search}"
                                                       Style="{DynamicResource FieldLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="CustomPanelSearchBox" Width="180" Height="28"
                                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{DynamicResource Custom.Picker.Search}" />
                                            <ComboBox x:Name="CustomPanelPicker" Width="240" Height="28" VerticalAlignment="Center"
                                                      Style="{DynamicResource ComboBoxExtend}"
                                                      IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                                                      ItemsSource="{Binding Available}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedItem="{Binding PendingAdd, Mode=TwoWay}" />
                                            <!-- ★ CommandParameter 直接绑下拉当前选中项：Command 内部不再依赖 PendingAdd -->
                                            <Button Content="{DynamicResource Custom.Picker.Add}" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding AddFeatureCommand}"
                                                    CommandParameter="{Binding SelectedItem, ElementName=CustomPanelPicker}" />
                                        </StackPanel>
                                        <!-- 提示语单独一行（横向行里长文案会把卡片顶宽）：空 = 正常。
                                             ★ 本块不在 CardRow 的 CustomPanel DataContext 作用域内，
                                               必须显式走 CustomPanel.PickerHint（绑定到窗口 VM 才解析得到） -->
                                        <TextBlock Text="{Binding CustomPanel.PickerHint}"
                                                   Style="{DynamicResource SecondaryText}"
                                                   Margin="2,0,0,2" />
                                    </StackPanel>
                                </Border>

                                <!-- ===== 面板内容 ===== -->
                                <TextBlock Text="{DynamicResource Custom.Panel.Header}" Style="{DynamicResource SectionHeaderText}" />
                                <Border Style="{DynamicResource SettingsCard}">
                                    <StackPanel DataContext="{Binding CustomPanel}">
                                        <!-- 列数 + 清空 -->
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="{DynamicResource Custom.Panel.Columns}"
                                                       Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                            <!-- 列数：SelectedValue 直接双向绑 CustomPanel.Columns（Tag 是字符串，WPF 自动转 int）⇒
                                                 不依赖 code-behind 的 SelectionChanged，避免 UIA/程序化改选时漏事件 -->
                                            <ComboBox x:Name="CustomPanelColumnsBox" Width="110" Height="28"
                                                      Style="{DynamicResource ThemedComboBox}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Columns, Mode=TwoWay}">
                                                <ComboBoxItem Content="{DynamicResource Custom.Panel.Columns.Auto}" Tag="0" />
                                                <ComboBoxItem Content="1" Tag="1" />
                                                <ComboBoxItem Content="2" Tag="2" />
                                                <ComboBoxItem Content="3" Tag="3" />
                                            </ComboBox>
                                            <Button Content="{DynamicResource Custom.Panel.Clear}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding ClearAllCommand}" />
                                            <!-- 保存配置：显式保存面板布局（改动本就自动落盘；此按钮=明确入口+反馈），
                                                 点击后短暂显示「已保存 ✓」由 code-behind 还原 -->
                                            <Button x:Name="CustomPanelSaveBtn"
                                                    Content="{DynamicResource Custom.Panel.Save}"
                                                    VerticalAlignment="Center" Margin="12,0,0,0"
                                                    ToolTip="{DynamicResource Custom.Panel.SaveTip}"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    Click="CustomPanelSaveBtn_Click" />
                                        </StackPanel>

                                        <!-- ===== 配置存档（多套面板，2026-09-25） ===== -->
                                        <TextBlock Text="{DynamicResource Custom.Preset.Header}"
                                                   Style="{DynamicResource SectionHeaderText}" Margin="0,4,0,4" />
                                        <StackPanel Style="{DynamicResource CardRow}">
                                            <TextBlock Text="{DynamicResource Custom.Preset.Name}"
                                                       Style="{DynamicResource FieldLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="CustomPanelPresetName" Width="130" Height="28"
                                                     Style="{DynamicResource ThemedTextBox}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                     Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Content="{DynamicResource Custom.Preset.Save}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0"
                                                    Style="{DynamicResource AccentButtonStyle}"
                                                    Command="{Binding SaveNewPresetCommand}" />
                                            <ComboBox x:Name="CustomPanelPresetsBox" Width="170" Height="28"
                                                      Style="{DynamicResource ThemedComboBox}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      ItemsSource="{Binding PresetNames}"
                                                      SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" />
                                            <Button Content="{DynamicResource Custom.Preset.Load}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                                    Command="{Binding LoadPresetCommand}" />
                                            <Button Content="{DynamicResource Custom.Preset.Delete}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DeletePresetCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Custom.Preset.Hint}"
                                                   Style="{DynamicResource SecondaryText}"
                                                   Margin="2,0,0,4" />

                                        <!-- 空面板提示 -->
                                        <TextBlock Text="{DynamicResource Custom.Panel.Empty}"
                                                   Style="{DynamicResource SecondaryText}"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                                        <!-- 面板主体：UniformGrid 的列数由 code-behind 按 VM.Columns 设定（模板内元素无法 FindName） -->
                                        <ItemsControl x:Name="CustomPanelItems" ItemsSource="{Binding Items}"
                                                      LayoutUpdated="CustomPanelItems_LayoutUpdated">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid x:Name="CustomPanelGrid" Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource ContentBackgroundBrush}"
                                                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="10,8,10,8" Margin="0,0,8,8">
                                                        <StackPanel>
                                                            <!-- 标题行：功能名 + 来源 + 上移/下移/移除 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextForegroundBrush}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{DynamicResource Custom.Item.From}"
                                                                               Style="{DynamicResource SecondaryText}"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding SourceTitle}"
                                                                               Style="{DynamicResource SecondaryText}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                                                                            Width="30" Height="26" Padding="0" Margin="0,0,4,0"
                                                                            ToolTip="{DynamicResource Custom.Item.MoveUp}"
                                                                            AutomationProperties.Name="{DynamicResource Custom.Item.MoveUp}"
                                                                            Command="{Binding Owner.MoveUpCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                                            Width="30" Height="26" Padding="0" Margin="0,0,4,0"
                                                                            ToolTip="{DynamicResource Custom.Item.MoveDown}"
                                                                            AutomationProperties.Name="{DynamicResource Custom.Item.MoveDown}"
                                                                            Command="{Binding Owner.MoveDownCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                            Width="30" Height="26" Padding="0"
                                                                            ToolTip="{DynamicResource Custom.Item.Remove}"
                                                                            AutomationProperties.Name="{DynamicResource Custom.Item.Remove}"
                                                                            Command="{Binding Owner.RemoveCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- 功能本体：由 CustomPanelItem.View 提供（ContentControl 承载） -->
                                                            <ContentControl Content="{Binding View}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="{DynamicResource Tab1.Header}" Tag="&#xE713;">
                <Border x:Name="Tab1ContentBorder" Margin="0,8,0,0" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                                  CanContentScroll="False">
                        <!-- ★ 2026-09-25 全局特性修改页排版重做（用户：「很多地方排版都很杂乱」）。
                             旧版病根：每个折叠组内部都是「Grid + 绝对坐标 Margin 手排」（如 Margin="239,35,0,0"、
                             Margin="499,10,0,0"），控件之间靠魔数定位 —— 改一个文案就会错位、窄窗口下方框互相压叠。
                             现改为流程布局：勾选项用 WrapPanel 自动换行，带标签的控件用
                             「字段名(固定宽) + 控件 + 数值 + 按钮」的四列 Grid 对齐。 -->
