                                                Style="{DynamicResource ActionButton}" Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding HealthZombieCommand}" />
                                    </StackPanel>
                                    <StackPanel Style="{DynamicResource CardRow}">
                                        <TextBlock Text="{DynamicResource Tab1.Page3.1stArmorHP}"
