                                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                                  SelectedValue="{Binding LockPresent}"
                                                  ItemsSource="{Binding Plants2}" Style="{DynamicResource ComboBoxExtend}"
                                                  IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value"
                                                  LostFocus="LockPresent_LostFocus" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{DynamicResource Tab1.Page3.Header}"
                                      Style="{DynamicResource Expander.Small}">
                                <StackPanel Margin="12,3,12,9">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Tab1.Page3.Description}"
                                                   Style="{DynamicResource SecondaryText}" />
                                    </Grid>
                                    <StackPanel Style="{DynamicResource CardRow}">
                                        <TextBlock Text="{DynamicResource Tab1.Page3.ZombieHP}"
                                                   Style="{DynamicResource FieldLabel}" Width="120" Margin="0,0,12,0" />
