                             直接把页宽绑到上层 ScrollViewer 的视口宽（ViewportWidth，已扣掉滚动条），
                             网格与长文本才会在可视区内正常换行。 -->
                        <Grid Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="10,8,10,10">
                            <!-- ===== 通用设置 ===== -->
                            <TextBlock Text="{DynamicResource Tab7.Section.General}" Style="{DynamicResource SectionHeaderText}" />
                            <Border Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <!-- 复选框统一 MinHeight=24 + 垂直居中（旧版写死 Height=21 会把 HandyControl 模板裁切） -->
                                    <CheckBox x:Name="SaveAndResume" Content="{DynamicResource Tab7.SaveAndResume}"
                                              IsChecked="{Binding NeedSave}"
                                              MinHeight="24" Margin="0,0,0,7"
                                              Foreground="{DynamicResource TextForegroundBrush}"
                                              BorderThickness="1" />
                                    <CheckBox x:Name="TopMostSprite" IsChecked="{Binding TopMostSprite}"
                                              Content="{DynamicResource Tab7.TopMostSprite}"
                                              MinHeight="24" Margin="0,0,0,7"
                                              Foreground="{DynamicResource TextForegroundBrush}"
                                              BorderThickness="1" />
                                    <CheckBox x:Name="EnableAnimations" IsChecked="{Binding EnableAnimations}"
                                              Content="{DynamicResource Tab7.EnableAnimations}"
                                              MinHeight="24" Margin="0"
                                              Foreground="{DynamicResource TextForegroundBrush}"
                                              BorderThickness="1"
                                              ToolTip="{DynamicResource Tab7.EnableAnimations.Tooltip}" />
                                </StackPanel>
                            </Border>

                            <!-- ===== 外观与窗口 ===== -->
                            <TextBlock Text="{DynamicResource Tab7.Section.Appearance}" Style="{DynamicResource SectionHeaderText}" />
                            <Border Style="{DynamicResource SettingsCard}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 深色模式切换：固定宽度（旧版无宽度约束，被拉伸成整行横条）。
                                         内联 Style 会整体替换隐式 Button 样式 ⇒ 必须显式补主题令牌（否则深色下白底白字）。 -->
                                    <Button x:Name="DarkMode" Command="{Binding ToggleDarkModeCommand}"
                                            Width="160" Height="30" Margin="0,0,10,0"
                                            ToolTip="{DynamicResource Tab7.DarkMode.Tooltip}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Height" Value="30" />
                                                <Setter Property="Width" Value="160" />
                                                <Setter Property="Padding" Value="14,0" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Background" Value="{DynamicResource ContentBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="Content" Value="{DynamicResource Tab7.DarkModeLight}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6"
                                                                    SnapsToDevicePixels="True">
                                                                <ContentPresenter x:Name="Cp"
                                                                                  Margin="{TemplateBinding Padding}"
                                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                                  RecognizesAccessKey="True"
                                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                        <Setter Property="Content" Value="{DynamicResource Tab7.DarkModeDark}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 还原窗口大小：交回隐式 Button 样式（旧版自带一套背景/边距，与同类按钮不一致） -->
                                    <Button x:Name="ResetWindowSizeButton"
                                            Content="{DynamicResource Tab7.ResetWindowSize}"
                                            Height="30" Padding="14,0"
                                            Click="ResetWindowSizeButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- ===== 关于与许可 ===== -->
                            <TextBlock Text="{DynamicResource Tab7.Section.About}" Style="{DynamicResource SectionHeaderText}" />
                            <Border Style="{DynamicResource SettingsCard}">
                                <StackPanel>
                                    <!-- 免费声明：说明条容器（自动换行、高度自适应），替掉旧版 Height=152 的 Label + Height=129 的 TextBlock。
                                         ★ 外层包一个单列 * 的 Grid：ScrollViewer 在水平方向会给子元素无限宽，
                                           直接放 TextBlock 会让它按理想宽度铺开、超出卡片右缘（实测被裁断而不是换行）；
                                           用星号列把宽度钉死为可用宽度，TextWrapping 才会真正生效。 -->
                                    <Border Style="{DynamicResource NoticeBanner}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{DynamicResource Tab1.Description}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource LinkForegroundBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <Button Content="{DynamicResource About.Title}"
                                            Command="{Binding ShowAboutCommand}"
                                            HorizontalAlignment="Left"
                                            Height="30" Padding="14,0" Margin="0,0,0,8" />
                                    <Expander Header="{DynamicResource Tab7.License}">
                                        <!-- 许可正文：主题化只读框 + 限高（旧版是裸 TextBox，深色下白底，且高度无约束） -->
                                        <TextBox IsReadOnly="True"
                                                 MaxHeight="260"
                                                 FontFamily="Consolas, Microsoft YaHei UI"
                                                 FontSize="12"
