                                                  SelectedValuePath="Key" DisplayMemberPath="Value"
                                                  ItemsSource="{Binding Zombies, Mode=OneWay}"
                                                  SelectedValue="{Binding HealthZombieType}"
                                                  Style="{DynamicResource ComboBoxExtend}"
                                                  IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Value" />
                                        <hc:NumericUpDown DecimalPlaces="0" x:Name="HealthZombieValue"
                                                          Width="90" Height="28" VerticalAlignment="Center" Margin="12,0,0,0"
                                                          Value="{Binding HealthZombieValue}" />
