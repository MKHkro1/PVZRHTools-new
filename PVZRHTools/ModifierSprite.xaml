<hc:SimplePanel x:Class="PVZRHTools.ModifierSprite"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:hc="https://handyorg.github.io/handycontrol"
                mc:Ignorable="d" Width="60" Height="60">
    <ContentControl MouseDoubleClick="ContentControl_MouseDoubleClick"
                    MouseEnter="ContentControl_MouseEnter"
                    MouseLeave="ContentControl_MouseLeave">
        <Border x:Name="SpriteBorder" Width="55" Height="55" CornerRadius="27.5" Background="#80000000" BorderBrush="{DynamicResource LabelForegroundBrush}" BorderThickness="2"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="SpriteScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Clip>
                <EllipseGeometry Center="27.5,27.5" RadiusX="27.5" RadiusY="27.5"/>
            </Border.Clip>
            <Border.Effect>
                <DropShadowEffect x:Name="SpriteGlow" Color="#60FFFFFF" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
            </Border.Effect>
            <Image Source="/PVZRHTools/icon.png" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </ContentControl>
</hc:SimplePanel>